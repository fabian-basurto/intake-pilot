# Copy to backend/.env (never committed). Read server-side only.
OPENAI_API_KEY=sk-...

# Optional: model used for extraction. Default: gpt-4.1 (documented for PDF input and Structured Outputs).
# OPENAI_MODEL=gpt-4.1

# Optional: browser origins allowed to call the API directly (the Next.js proxy does not need this).
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
